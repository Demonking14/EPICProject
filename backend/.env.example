# MongoDB connection string (from MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agrimarket?retryWrites=true&w=majority

# JWT secret for signing tokens (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server port (default 5000)
PORT=5000

# Optional: base URL for uploaded images (e.g. http://localhost:5000)
BASE_URL=http://localhost:5000

# Mandi (AGMARKNET) daily price API - get key from data.gov.in
# Optional: override API base URL if different (default: data.gov.in resource for mandi prices)
MANDI_API_KEY=your-data-gov-in-api-key
# MANDI_API_BASE_URL=https://api.data.gov.in/resource/<resource-uuid>
